# Local development uses SQLite when DATABASE_URL is omitted.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
JWT_COOKIE_SECURE=false

# Production (Railway PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Railway, attach a persistent Volume at /data. Uploads are then retained
# across deployments at this location (the production default is /data/media).
# MEDIA_ROOT=/data/media
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Set CREATE_DEFAULT_SUPERUSER=true in Railway to run ensure_superuser on startup.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DEFAULT_SUPERUSER_UPDATE_PASSWORD=false
